# ==============================================================================
# AccessRoute Environment Configuration Example
# Copy this file to .env:
#   cp .env.example .env
# Then fill in any values you need. All variables have sensible defaults;
# the application runs locally without any API keys or passwords.
# ==============================================================================

# ------------------------------------------------------------------------------
# Traffic Dataset Configuration
# ------------------------------------------------------------------------------

# Path to the Electronic City simulated traffic dataset folder.
# If left unset or commented out, the backend loader defaults to:
#   ~/Downloads/electronic-city-traffic-clean
# The dataset is ~125 MB of NumPy binary matrices and is NOT included in the
# repository. Obtain it from the project team and extract it locally.
# TRAFFIC_DATASET_DIR=~/Downloads/electronic-city-traffic-clean

# Alternative env var name accepted by the traffic loader (same purpose as above).
# ELECTRONIC_CITY_DATASET_DIR=~/Downloads/electronic-city-traffic-clean

# ------------------------------------------------------------------------------
# OSMnx Cache & Networking Settings
# (Used by the pedestrian network provider to fetch OpenStreetMap data)
# ------------------------------------------------------------------------------

# Directory for OSMnx HTTP response cache files (JSON).
ROUTING_OSMNX_CACHE_DIR=./cache

# HTTP request timeout in seconds for Overpass API calls.
ROUTING_OSMNX_TIMEOUT=90

# User-Agent header sent with OSMnx HTTP requests.
ROUTING_OSMNX_USER_AGENT=AccessRoute/1.0 (academic-research-project)

# ------------------------------------------------------------------------------
# In-Memory & Disk Graph Caching
# (Controls the pedestrian network graph cache behaviour)
# ------------------------------------------------------------------------------

# Maximum number of graph entries held in the in-memory LRU cache.
ROUTING_GRAPH_CACHE_MAX_SIZE=32

# Time-to-live (in seconds) for cached graph entries before eviction.
ROUTING_GRAPH_CACHE_TTL_SECONDS=3600

# Directory for pickled graph files persisted to disk.
ROUTING_GRAPH_DISK_CACHE_DIR=./cache/graphs

# ------------------------------------------------------------------------------
# Geographic Bounding Box Limits
# (Safety constraints for pedestrian network download area)
# ------------------------------------------------------------------------------

# Buffer in meters added around origin/destination when computing network bounds.
ROUTING_NETWORK_BUFFER_METERS=1000

# Maximum allowed diagonal distance (in meters) between origin and destination.
# Requests exceeding this are rejected to prevent huge OSM downloads.
ROUTING_MAX_NETWORK_DIAGONAL_METERS=20000

# ------------------------------------------------------------------------------
# CORS Configuration
# (Cross-Origin Resource Sharing for the FastAPI backend)
# ------------------------------------------------------------------------------

# Comma-separated list of additional allowed origins beyond localhost defaults.
# Leave empty or unset for local development (localhost:5173/5174/4173 are
# always allowed). Example: https://myapp.example.com,https://staging.example.com
# CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# Computer Vision Configuration
# (YOLO model and inference device settings)
# ------------------------------------------------------------------------------

# Path to YOLO model weights file. Defaults to backend/vision/weights/yolo11n.pt.
# The included yolo11n.pt (~5.6 MB) ships with the project. If missing, the
# backend auto-downloads standard weights on first analysis run.
# VISION_MODEL_PATH=backend/vision/weights/yolo11n.pt

# Compute device for YOLO inference: 'cpu' (default) or 'mps' (Apple Silicon GPU).
# VISION_DEVICE=cpu

# ------------------------------------------------------------------------------
# Frontend Configuration (Used by Vite dev server & production builds)
# Variables prefixed with VITE_ are exposed to the browser client.
# ------------------------------------------------------------------------------

# Base URL for the backend API. Must match the uvicorn host:port.
VITE_API_BASE_URL=http://localhost:8000

# Feature flag: set to 'true' to show the experimental Traffic & Route Impact tab.
# Hidden by default because it requires camera homography calibration data.
# VITE_ENABLE_TRAFFIC_IMPACT_TAB=false
